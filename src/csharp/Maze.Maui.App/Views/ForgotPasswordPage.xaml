<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodel="clr-namespace:Maze.Maui.App.ViewModels"
             x:DataType="viewmodel:ForgotPasswordViewModel"
             x:Class="Maze.Maui.App.Views.ForgotPasswordPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringNotEmptyConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertBoolConverter" />
    </ContentPage.Resources>

    <Grid VerticalOptions="Fill"
          HorizontalOptions="Fill">

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="30"
                                 Spacing="16"
                                 MaximumWidthRequest="400"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Border HeightRequest="100"
                        WidthRequest="100"
                        StrokeShape="Ellipse"
                        Padding="0"
                        HorizontalOptions="Center">
                    <Image Source="app.png"
                           Aspect="AspectFill"
                           HeightRequest="100"
                           WidthRequest="100" />
                </Border>

                <Label Text="Forgot Password"
                       FontSize="36"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <!-- Form state: email entry + submit. Hidden once the request lands successfully. -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding Submitted, Converter={StaticResource InvertBoolConverter}}">

                    <Label Text="Enter the email associated with your account and we'll send you a reset link."
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,8" />

                    <Grid ColumnSpacing="8" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Email"
                               VerticalOptions="Center" />
                        <Entry Grid.Row="0" Grid.Column="1"
                               Text="{Binding Email}"
                               ReturnType="Go"
                               ReturnCommand="{Binding SubmitCommand}"
                               Keyboard="Email"
                               MinimumWidthRequest="150" />
                    </Grid>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           HorizontalOptions="Center" />

                    <Button Text="Send Reset Link"
                            Command="{Binding SubmitCommand}"
                            HorizontalOptions="Fill" />

                    <Button Text="Back to sign in"
                            Command="{Binding BackToSignInCommand}"
                            HorizontalOptions="Fill"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                </VerticalStackLayout>

                <!-- Success state: anti-enumeration copy + back link. -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding Submitted}">

                    <Label Text="If that email is registered, we've sent a password reset link. Check your inbox."
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Back to sign in"
                            Command="{Binding BackToSignInCommand}"
                            HorizontalOptions="Fill" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center" />

    </Grid>

</ContentPage>
