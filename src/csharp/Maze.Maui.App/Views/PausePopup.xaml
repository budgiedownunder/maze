<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Maze.Maui.App.Views.PausePopup"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Padding="24"
            StrokeShape="RoundRectangle 12"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

        <VerticalStackLayout Spacing="16" HorizontalOptions="Center" MinimumWidthRequest="260">

            <Label Text="Paused"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1" BackgroundColor="Gray" HorizontalOptions="Fill" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Resume"
                        Clicked="OnResumeClicked" />
                <Button Grid.Column="1"
                        Text="Restart"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}"
                        Clicked="OnRestartClicked" />
            </Grid>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>
