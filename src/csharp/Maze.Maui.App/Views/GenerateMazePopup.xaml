<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Maze.Maui.App.Views.GenerateMazePopup"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <!--
        Asymmetric padding: full vertical breathing room, reduced
        left/right padding so the bottom button row keeps more
        horizontal space for its button labels on narrow phone screens.

        `MaximumWidthRequest` is the hard cap that prevents the popup
        from sizing to the parent window's full width on desktop. The
        ScrollView below claims Fill on the horizontal axis (its
        measure pass reports the full constraint it was handed,
        regardless of `HorizontalOptions`), which would stretch the
        popup to the platform popup container's width without this
        cap.
    -->
    <Border Padding="12,20"
            MaximumWidthRequest="320"
            StrokeShape="RoundRectangle 8"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">

        <!--
            Vertical scrolling on short viewports — the popup would
            otherwise extend off-screen on phone landscape / smaller
            phone-portrait. The ScrollView is bounded by
            `MaximumHeightRequest`: content shorter than that doesn't
            scroll (the popup stays at its natural height), longer
            content scrolls inside the cap.

            `HorizontalOptions="Center"` is needed to stop the
            ScrollView from claiming Fill horizontally and dragging
            the popup width up to the parent container's full width.
        -->
        <ScrollView MaximumHeightRequest="600" HorizontalOptions="Center">
        <!--
            No `MinimumWidthRequest` floor — the layout sizes to its
            natural content width on every platform, which avoids any
            overflow/clipping at the right edge on narrow phone
            simulators. The Border above caps the upper end at
            `MaximumWidthRequest="320"` for desktop.
        -->
        <VerticalStackLayout Spacing="12">

            <!-- Title -->
            <Label Text="Generate Maze"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4"/>

            <!-- Fields -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">

                <Label Grid.Row="0" Grid.Column="0" Text="Rows" VerticalOptions="Center"/>
                <Entry Grid.Row="0" Grid.Column="1" x:Name="RowsEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="1" Grid.Column="0" Text="Columns" VerticalOptions="Center"/>
                <Entry Grid.Row="1" Grid.Column="1" x:Name="ColsEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="2" Grid.Column="0" Text="Start Row" VerticalOptions="Center"/>
                <Entry Grid.Row="2" Grid.Column="1" x:Name="StartRowEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="3" Grid.Column="0" Text="Start Column" VerticalOptions="Center"/>
                <Entry Grid.Row="3" Grid.Column="1" x:Name="StartColEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="4" Grid.Column="0" Text="Finish Row" VerticalOptions="Center"/>
                <Entry Grid.Row="4" Grid.Column="1" x:Name="FinishRowEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="5" Grid.Column="0" Text="Finish Column" VerticalOptions="Center"/>
                <Entry Grid.Row="5" Grid.Column="1" x:Name="FinishColEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="6" Grid.Column="0" Text="Min Solution Length" VerticalOptions="Center"/>
                <Entry Grid.Row="6" Grid.Column="1" x:Name="MinSolutionLengthEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="7" Grid.Column="0" Text="Doors" VerticalOptions="Center"/>
                <Entry Grid.Row="7" Grid.Column="1" x:Name="DoorCountEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="8" Grid.Column="0" Text="Spare Doors" VerticalOptions="Center"/>
                <Entry Grid.Row="8" Grid.Column="1" x:Name="SpareDoorsEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

                <Label Grid.Row="9" Grid.Column="0" Text="Spare Keys" VerticalOptions="Center"/>
                <Entry Grid.Row="9" Grid.Column="1" x:Name="SpareKeysEntry" Keyboard="Numeric" HorizontalOptions="Fill"/>

            </Grid>

            <!-- Validation error -->
            <Label x:Name="ErrorLabel"
                   TextColor="{AppThemeBinding Light={StaticResource Fail}, Dark={StaticResource FailDark}}"
                   FontSize="12"
                   IsVisible="False"
                   HorizontalOptions="Center"/>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                <Button Grid.Column="0" x:Name="CancelButton" Text="Cancel" Clicked="OnCancelClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray100}}"/>
                <Button Grid.Column="1" x:Name="GenerateButton" Text="Generate" Clicked="OnGenerateClicked"/>
            </Grid>

        </VerticalStackLayout>
        </ScrollView>
    </Border>

</toolkit:Popup>
