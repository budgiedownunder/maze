<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Maze.Maui.App.ViewModels"
             xmlns:controls="clr-namespace:Maze.Maui.App"
             x:DataType="viewmodel:Play3dScopeBrowserViewModel"
             x:Class="Maze.Maui.App.Play3dScopeBrowserView">

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="8">

        <!-- Tab strip (+ sort for the searchable scope). -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ShowingGames}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowGamesCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Games" Padding="18,8" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowingGames}" Value="True">
                                <Setter Property="FontAttributes" Value="Bold" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ShowingCollections}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowCollectionsCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="Collections" Padding="18,8" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowingCollections}" Value="True">
                                <Setter Property="FontAttributes" Value="Bold" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>
            <HorizontalStackLayout Grid.Column="2" IsVisible="{Binding CanSort}" Spacing="6" VerticalOptions="Center">
                <Label Text="Sort" VerticalOptions="Center" />
                <Picker SelectedIndex="{Binding SortIndex}" MinimumWidthRequest="110">
                    <Picker.Items>
                        <x:String>A–Z</x:String>
                        <x:String>Newest</x:String>
                    </Picker.Items>
                </Picker>
            </HorizontalStackLayout>
        </Grid>

        <!-- The two tab lists (each its own reusable list body); only the selected one shows. -->
        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding ShowingGames}">
                <controls:Play3dListView BindingContext="{Binding Games}" />
            </Grid>
            <Grid IsVisible="{Binding ShowingCollections}">
                <controls:Play3dListView BindingContext="{Binding Collections}" />
            </Grid>
        </Grid>
    </Grid>
</ContentView>
